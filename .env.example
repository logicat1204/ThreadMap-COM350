OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3000
# Opcionales: el secreto se genera en data/session-secret al iniciar en local.
APP_URL=
BETTER_AUTH_SECRET=
DATABASE_PATH=data/threadmap.sqlite
# Solo con el proxy Caddy local configurado para sobrescribir la cabecera de IP.
TRUST_PROXY=
# Intentos por minuto y dirección IP; valores predeterminados en local: 8 y 5.
AUTH_SIGNIN_RATE_LIMIT=
AUTH_SIGNUP_RATE_LIMIT=
